{
  "name": "voxellume",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Minecraft modding procedures and tooling for OMP and DeepSeek Harness.",
  "license": "MIT",
  "main": "./dist/adapters/dsh/index.js",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/adapters/dsh/index.d.ts",
      "import": "./dist/adapters/dsh/index.js"
    },
    "./omp": {
      "types": "./dist/adapters/omp/index.d.ts",
      "import": "./dist/adapters/omp/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/index.d.ts",
      "import": "./dist/adapters/dsh/index.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/adapters/omp/index.js"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills",
    "agents",
    "commands",
    "targets",
    "templates",
    "docs",
    "scripts",
    "THIRD_PARTY"
  ],
  "scripts": {
    "build": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:unit": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --experimental-strip-types \"tests/integration/**/*.test.ts\"",
    "test:live": "node --test --experimental-strip-types --test-timeout=3600000 \"tests/live/**/*.test.ts\"",
    "check:structure": "node scripts/check-structure.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm check:structure && pnpm check:pack && pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@oh-my-pi/pi-coding-agent": "18.17.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "zod": "4.6.6"
  }
}
