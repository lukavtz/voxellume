{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxellume.local/schemas/mod-spec-1.0.0.schema.json",
  "title": "Voxellume ModSpec 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modId",
    "namespace",
    "javaPackage",
    "metadata",
    "targetPackId",
    "targetPackRevision",
    "dependencies",
    "compatibility",
    "gameplay",
    "features",
    "implementationUnits",
    "configuration",
    "persistence",
    "assets",
    "acceptance",
    "runtime",
    "visual",
    "evidence",
    "delivery"
  ],
  "properties": {
    "schemaVersion": { "const": "mod-spec-1.0.0" },
    "modId": { "$ref": "#/$defs/identifier" },
    "namespace": { "$ref": "#/$defs/identifier" },
    "javaPackage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "authors", "license"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "license": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "targetPackId": { "$ref": "#/$defs/nonEmptyString" },
    "targetPackRevision": { "type": "integer", "minimum": 1 },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "incompatible"],
      "properties": {
        "required": { "$ref": "#/$defs/dependencies" },
        "optional": { "$ref": "#/$defs/dependencies" },
        "incompatible": { "$ref": "#/$defs/dependencies" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleplayer", "multiplayer", "existingWorlds"],
      "properties": {
        "singleplayer": { "type": "boolean" },
        "multiplayer": { "enum": ["unsupported", "optional", "required"] },
        "existingWorlds": { "enum": ["unsupported", "compatible", "migrate"] }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "progression", "multiplayer", "failureCases"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "progression": { "$ref": "#/$defs/nonEmptyString" },
        "multiplayer": { "$ref": "#/$defs/nonEmptyString" },
        "failureCases": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "implementationUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "featureId", "sourcePaths"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "featureId": { "$ref": "#/$defs/identifier" },
          "sourcePaths": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "entries"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "default"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "kind": { "enum": ["boolean", "integer", "string"] },
              "default": true,
              "minimum": { "type": "number" },
              "maximum": { "type": "number" }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "migrations"],
      "properties": {
        "format": { "enum": ["nbt", "json"] },
        "version": { "type": "integer", "minimum": 1 },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "fromVersion", "toVersion", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "fromVersion": { "type": "integer", "minimum": 0 },
              "toVersion": { "type": "integer", "minimum": 0 },
              "description": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "generated"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "$ref": "#/$defs/nonEmptyString" },
          "source": { "$ref": "#/$defs/nonEmptyString" },
          "generated": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptance" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios"],
      "properties": {
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "acceptanceIds", "steps", "expected"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "acceptanceIds": { "$ref": "#/$defs/idList" },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              },
              "expected": true
            }
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric", "scenarioIds", "required"],
      "properties": {
        "rubric": { "$ref": "#/$defs/nonEmptyString" },
        "scenarioIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "required": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "artifactGlobs"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "unit",
              "resource",
              "build",
              "server",
              "client",
              "gameTest",
              "visual"
            ]
          }
        },
        "artifactGlobs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionJar",
        "includeSource",
        "includeEditableAssets",
        "buildTasks"
      ],
      "properties": {
        "productionJar": { "$ref": "#/$defs/nonEmptyString" },
        "includeSource": { "type": "boolean" },
        "includeEditableAssets": { "type": "boolean" },
        "buildTasks": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["clean", "build", "test"] }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modId", "version"],
        "properties": {
          "modId": { "$ref": "#/$defs/nonEmptyString" },
          "version": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "names",
        "properties",
        "implementationUnitIds",
        "assetIds",
        "acceptanceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "item",
            "block",
            "entity",
            "recipe",
            "worldgen",
            "gui",
            "mechanic"
          ]
        },
        "names": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        },
        "properties": { "type": "object" },
        "implementationUnitIds": { "$ref": "#/$defs/idList" },
        "assetIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "acceptanceIds": { "$ref": "#/$defs/idList" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "featureId",
        "behavior",
        "kind",
        "implementationUnitIds",
        "checkIds",
        "fixture",
        "expected"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "featureId": { "$ref": "#/$defs/identifier" },
        "behavior": { "$ref": "#/$defs/nonEmptyString" },
        "kind": {
          "enum": [
            "unit",
            "resource",
            "build",
            "server",
            "client",
            "gameTest",
            "visual"
          ]
        },
        "implementationUnitIds": { "$ref": "#/$defs/idList" },
        "checkIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "fixture": { "$ref": "#/$defs/nonEmptyString" },
        "expected": true
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "featureId", "kind", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "featureId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["item", "count"],
          "properties": {
            "item": { "$ref": "#/$defs/nonEmptyString" },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
