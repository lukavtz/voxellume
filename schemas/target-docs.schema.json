{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxellume.invalid/schemas/target-docs.schema.json",
  "title": "Voxellume target documentation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "retrievedAt",
    "minecraftRelease",
    "loaderApi",
    "gradlePlugins",
    "catalogs"
  ],
  "properties": {
    "schemaVersion": { "const": "target-docs-1.0.0" },
    "retrievedAt": { "type": "string", "minLength": 1 },
    "minecraftRelease": { "$ref": "#/$defs/document" },
    "loaderApi": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedDocument" }
    },
    "gradlePlugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/pluginDocument" }
    },
    "catalogs": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalog" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Saved response SHA-256 evidence"
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "exactVersion": {
      "type": "string",
      "pattern": "^(?!.*[Ss][Nn][Aa][Pp][Ss][Hh][Oo][Tt])[0-9]+(?:\\.[0-9]+)*(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "responseSha256"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "$ref": "#/$defs/exactVersion" },
        "responseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "namedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "revision", "responseSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "$ref": "#/$defs/exactVersion" },
        "responseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pluginDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "url", "revision", "responseSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/exactVersion" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "$ref": "#/$defs/exactVersion" },
        "responseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "responseSha256"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "responseSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
