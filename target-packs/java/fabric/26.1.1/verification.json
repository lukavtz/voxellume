{
  "schemaVersion": "target-verification-1.0.0",
  "capabilities": {
    "build": true,
    "server": true,
    "client": false,
    "gameTest": true,
    "visual": true
  },
  "required": [
    "build",
    "server",
    "client",
    "gameTest",
    "visual"
  ],
  "checks": {
    "build": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "clean",
        "build"
      ],
      "assertions": [
        "Qualification requires exit code 0 and a production JAR."
      ],
      "artifactGlobs": [
        "build/libs/*.jar",
        "build/reports/**"
      ]
    },
    "server": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runServer"
      ],
      "assertions": [
        "Qualification requires the dedicated server startup assertion."
      ],
      "artifactGlobs": [
        "run/logs/*.log"
      ]
    },
    "client": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClientGameTest"
      ],
      "assertions": [
        "Records configured client GameTest evidence only; the singleplayer assertion passed but JVM shutdown exited 134 in libopenal.so, so client capability is false."
      ],
      "artifactGlobs": [
        "build/run/clientGameTest/**",
        "build/reports/**"
      ]
    },
    "visual": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClient"
      ],
      "assertions": [
        "Qualification requires reviewed inventory, hand, world, GUI, and animation captures."
      ],
      "artifactGlobs": [
        "verification/screenshots/*.png"
      ]
    },
    "gameTest": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "build"
      ],
      "assertions": [
        "build completes configured server GameTests through runGameTest; the positive fixture passed and the deliberate negative control failed as designed."
      ],
      "artifactGlobs": [
        "build/run/gameTest/**",
        "build/reports/**"
      ]
    }
  },
  "testedPlatforms": [
    {
      "os": "linux",
      "arch": "arm64"
    }
  ]
}
