{
  "schemaVersion": "target-verification-1.0.0",
  "capabilities": {
    "build": true,
    "server": true,
    "client": false,
    "gameTest": true,
    "visual": true
  },
  "required": [
    "build",
    "server",
    "client",
    "gameTest",
    "visual"
  ],
  "checks": {
    "build": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "clean",
        "build"
      ],
      "assertions": [
        "Qualification requires exit code 0 and a production JAR."
      ],
      "artifactGlobs": [
        "build/libs/*.jar",
        "build/reports/**"
      ]
    },
    "server": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runServer"
      ],
      "assertions": [
        "Qualification requires the dedicated server startup assertion."
      ],
      "artifactGlobs": [
        "run/logs/*.log"
      ]
    },
    "client": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClientGameTest"
      ],
      "assertions": [
        "Records configured client GameTest evidence only; this is not production-client main-menu or mod-error qualification."
      ],
      "artifactGlobs": [
        "build/run/clientGameTest/**",
        "build/reports/**"
      ]
    },
    "visual": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClient"
      ],
      "assertions": [
        "Qualification requires reviewed inventory, hand, world, GUI, and animation captures."
      ],
      "artifactGlobs": [
        "verification/screenshots/*.png"
      ]
    },
    "gameTest": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "build"
      ],
      "assertions": [
        "Qualification requires build to complete all configured server GameTests through its runGameTest dependency."
      ],
      "artifactGlobs": [
        "build/run/gameTest/**",
        "build/reports/**"
      ]
    }
  },
  "testedPlatforms": [
    {
      "os": "linux",
      "arch": "arm64"
    }
  ],
  "evidenceManifest": {
    "path": "qualification/java-fabric-26.1-r1/result.json",
    "sha256": "117ec257e2312fcdc1230a7915dbd03272cd9f2f4eb00ef06b98cef347f81f3b"
  }
}
