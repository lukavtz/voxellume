{
  "schemaVersion": "target-verification-1.0.0",
  "capabilities": {
    "build": false,
    "server": false,
    "client": false,
    "gameTest": false,
    "visual": false
  },
  "required": [
    "build",
    "server",
    "client",
    "gameTest",
    "visual"
  ],
  "checks": {
    "build": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "clean",
        "build"
      ],
      "assertions": [
        "Qualification requires exit code 0 and a production JAR."
      ],
      "artifactGlobs": [
        "build/libs/*.jar",
        "build/reports/**"
      ]
    },
    "server": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runServer"
      ],
      "assertions": [
        "Qualification requires the dedicated server startup assertion."
      ],
      "artifactGlobs": [
        "run/logs/*.log"
      ]
    },
    "client": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClient"
      ],
      "assertions": [
        "Qualification requires the client main-menu and mod-error assertions."
      ],
      "artifactGlobs": [
        "run/logs/*.log"
      ]
    },
    "visual": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClient"
      ],
      "assertions": [
        "Qualification requires reviewed inventory, hand, world, GUI, and animation captures."
      ],
      "artifactGlobs": [
        "verification/screenshots/*.png"
      ]
    },
    "gameTest": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runGameTestServer"
      ],
      "assertions": [
        "Qualification requires all configured GameTests to pass."
      ],
      "artifactGlobs": [
        "run/logs/*.log",
        "build/reports/**"
      ]
    }
  },
  "testedPlatforms": []
}
