{
  "schemaVersion": "target-verification-1.0.0",
  "capabilities": {
    "build": true,
    "server": false,
    "client": false,
    "gameTest": false,
    "visual": false
  },
  "required": [
    "build",
    "server",
    "client",
    "visual"
  ],
  "checks": {
    "build": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "clean",
        "build"
      ],
      "assertions": [
        "Qualification requires exit code 0 and a production JAR."
      ],
      "artifactGlobs": [
        "build/libs/*.jar",
        "build/reports/**"
      ]
    },
    "server": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runServer"
      ],
      "assertions": [
        "Qualification requires the dedicated server startup assertion."
      ],
      "artifactGlobs": [
        "run/logs/*.log"
      ]
    },
    "client": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClient"
      ],
      "assertions": [
        "The real client remained in downloadAssets and was deliberately stopped with exit 137; no client capability is claimed."
      ],
      "artifactGlobs": [
        "run/logs/*.log"
      ]
    },
    "visual": {
      "argv": [
        "./gradlew",
        "--no-daemon",
        "runClient"
      ],
      "assertions": [
        "The only real-client capture was uniformly black and was rejected; no visual capability is claimed."
      ],
      "artifactGlobs": [
        "verification/screenshots/*.png"
      ]
    }
  },
  "testedPlatforms": [
    {
      "os": "linux",
      "arch": "arm64"
    }
  ]
}
